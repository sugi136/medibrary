# 이 파일을 .env로 복사해 개인 값으로 교체하세요. .env는 Git에 커밋하지 않습니다.
# Supabase Dashboard > Project Settings > Database > Connect에서 실제 TLS 연결 정보를 확인합니다.
DB_URL=jdbc:postgresql://db.your-project-ref.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-supabase-database-password
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_EXPIRATION_SECONDS=86400
DATA_GO_KR_SERVICE_KEY=your-data-go-kr-service-key
OPENFDA_BASE_URL=https://api.fda.gov
EXTERNAL_API_TIMEOUT_MILLIS=3000
# Vercel Production URL을 Render에 배포한 뒤 실제 주소로 바꿉니다.
CORS_ALLOWED_ORIGINS=http://localhost:5173
