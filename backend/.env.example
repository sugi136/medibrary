# 이 파일을 .env로 복사해 개인 값으로 교체하세요. .env는 Git에 커밋하지 않습니다.
# Render Free에서 Supabase Free에 연결할 때는 Dashboard 상단 Connect > Session pooler의 값을 우선 사용합니다.
# Session pooler는 IPv4 기반의 지속 실행 백엔드 연결에 적합합니다.
DB_URL=jdbc:postgresql://aws-your-region.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=replace-with-your-supabase-database-password
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_EXPIRATION_SECONDS=86400
DATA_GO_KR_SERVICE_KEY=your-data-go-kr-service-key
OPENFDA_BASE_URL=https://api.fda.gov
EXTERNAL_API_TIMEOUT_MILLIS=3000
# Vercel Production URL을 Render에 배포한 뒤 실제 주소로 바꿉니다.
CORS_ALLOWED_ORIGINS=http://localhost:5173
